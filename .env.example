# FinFlow Environment Configuration
# Copy to .env and fill in actual values

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://finflow:changeme@localhost:5432/finflow
# For SQLite fallback (local dev without PostgreSQL):
# DATABASE_URL=sqlite:///./finflow.db

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret-key

# API
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
DASHBOARD_PORT=8501

# Data Generation
DATA_SEED=42
DATA_NUM_TRANSACTIONS=500

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.csv

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
